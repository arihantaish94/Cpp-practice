    "version": "0.2.0",
    "configurations": [
    {
        "name": "cache_lab_execution_time",
        "type": "cppdbg",
        "request": "launch",
        "program": "/home/arihantaish94/projects/cache_lab/build/execution_time",
        "stopAtEntry": false,
        "cwd": "/home/arihantaish94/projects/cache_lab/build/",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
    {
      "name": "Debug helloworld file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/cpppractice/build/helloWorld",
      "cwd": "${workspaceFolder}/cpppractice/build",
      "MIMode": "gdb",
      "preLaunchTask": "build active file",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
     {
      "name": "Debug vectorInOut file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/cpppractice/build/vectorInOut",
      "cwd": "${workspaceFolder}/cpppractice/build",
      "MIMode": "gdb",
      "preLaunchTask": "build active file",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
    ]
}