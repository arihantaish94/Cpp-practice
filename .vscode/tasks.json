{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build active file",
      "type": "shell",
      "command": "cmake -S \"${workspaceFolder}/cpppractice\" -B \"${workspaceFolder}/cpppractice/build\" -DCMAKE_BUILD_TYPE=Debug && cmake --build \"${workspaceFolder}/cpppractice/build\"",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run active file",
      "type": "shell",
      "command": "\"${workspaceFolder}/cpppractice/build/helloWorld\"",
      "dependsOn": "build active file",
      "problemMatcher": []
    }
  ]
}